# 变量必须以 VITE_ 为前缀才能暴露给外部读取
NODE_ENV = 'development'
# 是否去除console 和 debugger
VITE_DELETE_CONSOLE = false
# 是否开启sourcemap
VITE_SHOW_SOURCEMAP = false

# development mode 后台请求地址(guard-find-server 用户侧服务)
VITE_SERVER_BASEURL = 'http://localhost:8000'
VITE_SERVER_BASEURL__WEIXIN_DEVELOP = 'http://localhost:8000'
VITE_SERVER_BASEURL__WEIXIN_TRIAL = 'http://localhost:8000'
VITE_SERVER_BASEURL__WEIXIN_RELEASE = 'http://localhost:8000'
VITE_SERVER_WS_URL = 'ws://localhost:8000'