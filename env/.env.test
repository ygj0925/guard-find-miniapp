# 变量必须以 VITE_ 为前缀才能暴露给外部读取
NODE_ENV = 'development'
# 是否去除console 和 debugger
VITE_DELETE_CONSOLE = false
# 是否开启sourcemap
VITE_SHOW_SOURCEMAP = false

# test mode 后台请求地址
# VITE_SERVER_BASEURL = 'https://test.xxx.com'
VITE_SERVER_BASEURL__WEIXIN_DEVELOP = 'https://dev-imapp.3sbio.com/sss-recruitment'
VITE_SERVER_BASEURL__WEIXIN_TRIAL = 'https://imapp.3sbio.com/sss-recruitment'
VITE_SERVER_BASEURL__WEIXIN_RELEASE = 'https://imapp.3sbio.com/sss-recruitment'